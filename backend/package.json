{
  "name": "nutridrop-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run types && tsc --noEmit",
    "deploy:staging": "wrangler deploy --env staging",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply nutridrop-db-local --local",
    "migrate:staging": "wrangler d1 migrations apply nutridrop-db-staging --remote --env staging",
    "test": "vitest run",
    "types": "wrangler types"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.22.0",
    "jose": "6.2.10",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.1.4",
    "@types/node": "^26.4.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.129.0"
  }
}
